#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/../config.sh"

[[ -f "$CONFIG_FILE" ]] || { echo "❌ Missing config file: $CONFIG_FILE"; exit 1; }
source "$CONFIG_FILE"

for dir in "${SYNC_LOCAL_DIRS[@]}"
do
   echo "======================= Synchronizing ${dir} ======================="
   rsync -Prauv --exclude ".DS_Store" "$SYNC_BASE_DIR/$dir/" "$SYNC_EXTERNAL_DRIVE_DIR/$dir"
done

date > "$SYNC_EXTERNAL_DRIVE_DIR/last_sync.txt"
echo "======================= Done Synchronizing! ======================="
