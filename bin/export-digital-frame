#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${PHOTO_SYNC_PIPELINE_HOME:-$HOME/.photo-sync-pipeline}"
CONFIG_FILE="$CONFIG_DIR/config.sh"
FALLBACK_CONFIG="$SCRIPT_DIR/../config.sh"

if [[ -f "$CONFIG_FILE" ]]; then
  true
elif [[ -f "$FALLBACK_CONFIG" ]]; then
  CONFIG_FILE="$FALLBACK_CONFIG"
else
  echo "❌ Missing config file: $CONFIG_FILE"
  echo "   Expected at: $CONFIG_FILE"
  echo "   Fallback tried: $FALLBACK_CONFIG"
  exit 1
fi
source "$CONFIG_FILE"

DEST="$DIGITAL_FRAME_DIR"
ALBUM="$DIGITAL_FRAME_ALBUM"

echo "▶ Preflight: checking ADB connection"
if ! adb connect "${ANDROID_IP}:${ANDROID_PORT}" >/dev/null 2>&1; then
  echo "❌ ADB connect failed for ${ANDROID_IP}:${ANDROID_PORT}."
  echo "   Fix Wireless debugging on the tablet, then re-run."
  exit 1
fi

if ! adb -s "${ANDROID_IP}:${ANDROID_PORT}" get-state >/dev/null 2>&1; then
  echo "❌ ADB device is not ready (${ANDROID_IP}:${ANDROID_PORT})."
  echo "   Fix the connection first, then re-run."
  exit 1
fi

mkdir -p "$DEST"

echo "▶ Cleaning local DigitalFrame folder (JPG only)"
rm -f "$DEST"/*.jpg "$DEST"/*.jpeg 2>/dev/null || true
rm -f "$DEST"/.osxphotos_export.db 2>/dev/null || true

echo "▶ Exporting Photos album: $ALBUM"
osxphotos export "$DEST" \
  --album "$ALBUM" \
  --only-photos \
  --skip-edited \
  --skip-live \
  --filename "{created.strftime,%Y-%m-%d %H.%M.%S.%f}"

echo "▶ Lowercasing extensions"
"$LOWERCASE_SCRIPT" "$DEST"

echo "▶ Resizing/compressing existing JPG/JPEG (max 2000px, quality 75)"
while IFS= read -r -d '' f; do
  tmp="${f%.*}.__tmp__.jpg"
  sips -Z 2000 -s format jpeg -s formatOptions 75 "$f" --out "$tmp" >/dev/null
  mv "$tmp" "${f%.*}.jpg"

  ext="${f##*.}"
  ext_lc="$(printf "%s" "$ext" | tr '[:upper:]' '[:lower:]')"
  [[ "$ext_lc" != "jpg" ]] && rm -f "$f"
done < <(find "$DEST" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" \) -print0)

echo "▶ Converting HEIC → JPG (no overwrite)"
while IFS= read -r -d '' f; do
  out="${f%.*}.jpg"
  [[ -e "$out" ]] && continue
  sips -Z 2000 -s format jpeg -s formatOptions 75 "$f" --out "$out" >/dev/null
done < <(find "$DEST" -maxdepth 1 -type f -iname "*.heic" -print0)

echo "▶ Removing source HEIC files"
find "$DEST" -maxdepth 1 -type f -iname "*.heic" -delete

shopt -s nullglob
files=( "$DEST"/*.jpg "$DEST"/*.jpeg )
if (( ${#files[@]} == 0 )); then
  echo "⚠️  No JPG/JPEG files found to send"
  exit 0
fi

echo "▶ Files to be transferred (${#files[@]}):"
for f in "${files[@]}"; do
  echo "   • $(basename "$f")"
done

echo "▶ Sending photos to tablet"
adb push "${files[@]}" "${ANDROID_DEST}/"

echo "▶ Triggering MediaStore scan"
adb shell content call \
  --method scan_volume \
  --uri content://media \
  --arg external_primary \
  >/dev/null 2>&1 || true

echo "▶ Restarting Fotoo"
adb shell am force-stop "$FOTOO_PKG" >/dev/null 2>&1 || true
adb shell monkey -p "$FOTOO_PKG" -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1 || true

echo "▶ Cleaning local DigitalFrame folder (JPG only)"
rm -f "$DEST"/*.jpg "$DEST"/*.jpeg 2>/dev/null || true

echo "▶ Clearing Photos album: $ALBUM"
if ! osascript "$CLEAR_ALBUM_SCRIPT" "$DIGITAL_FRAME_ALBUM"; then
  echo "❌ Failed to clear Photos album: $DIGITAL_FRAME_ALBUM"
  echo "   Verify the album exists in Photos."
  exit 1
fi

echo "▶ Running backups"
"$SYNC_EXTERNAL_CMD" && "$SYNC_BACKUP_CMD"

echo "✅ export-digital-frame complete"
