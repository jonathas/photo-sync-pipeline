#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${PHOTO_SYNC_PIPELINE_HOME:-$HOME/.photo-sync-pipeline}"
CONFIG_FILE="$CONFIG_DIR/config.sh"
FALLBACK_CONFIG="$SCRIPT_DIR/../config.sh"

if [[ -f "$CONFIG_FILE" ]]; then
  true
elif [[ -f "$FALLBACK_CONFIG" ]]; then
  CONFIG_FILE="$FALLBACK_CONFIG"
else
  echo "❌ Missing config file: $CONFIG_FILE"
  echo "   Expected at: $CONFIG_FILE"
  echo "   Fallback tried: $FALLBACK_CONFIG"
  exit 1
fi
source "$CONFIG_FILE"

for dir in "${SYNC_LOCAL_DIRS[@]}"
do
   echo "======================= Synchronizing ${dir} ======================="
   rsync -Prauv --exclude ".DS_Store" "$SYNC_BASE_DIR/$dir/" "$SYNC_EXTERNAL_DRIVE_DIR/$dir"
done

date > "$SYNC_EXTERNAL_DRIVE_DIR/last_sync.txt"
echo "======================= Done Synchronizing! ======================="
