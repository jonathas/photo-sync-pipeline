#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   export-photos-since YYYY-MM-DD
#
# Example:
#   export-photos-since 2026-01-25

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/../config.sh"

[[ -f "$CONFIG_FILE" ]] || { echo "❌ Missing config file: $CONFIG_FILE"; exit 1; }
source "$CONFIG_FILE"

START_DATE="${1:-}"

if [[ -z "$START_DATE" ]]; then
  echo "Usage: $0 YYYY-MM-DD"
  exit 1
fi

if ! [[ "$START_DATE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
  echo "❌ Invalid date format. Use YYYY-MM-DD"
  exit 1
fi

DEST="$CAMERA_UPLOADS_DIR"
mkdir -p "$DEST"

echo "▶ Exporting photos & videos since $START_DATE → $DEST"

osxphotos export "$DEST" \
  --from-date "$START_DATE" \
  --skip-live \
  --skip-edited \
  --update \
  --directory "{created.year}/{created.mm} - {created.month}/{created.strftime,%Y-%m-%d}" \
  --filename "{created.strftime,%Y-%m-%d %H.%M.%S.%f}"

echo "▶ Lowercasing file extensions"
"$LOWERCASE_SCRIPT" "$DEST"

echo "✅ export-photos-since complete"
